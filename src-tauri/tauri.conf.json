{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ridermaster-pro",
  "version": "0.1.0",
  "identifier": "com.magovitucoproducciones.ridermaster",

  "build": {
    "devUrl": "http://localhost:9002",
    "frontendDist": "../out",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RiderMaster Pro",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Utility"
  }
}
